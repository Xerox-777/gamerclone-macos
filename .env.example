# GamerClone Development Environment Variables
# Copy this to .env and fill in your API keys

# Deepgram - Speech-to-Text
# Get your key at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Anthropic Claude - Vision Analysis  
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ElevenLabs - Text-to-Speech
# Get your key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Backend API URL (for license validation)
# In production, this points to your actual backend
API_BASE_URL=https://api.gamerclone.com

# Development mode
NODE_ENV=development
